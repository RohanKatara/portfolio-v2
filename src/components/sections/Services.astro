---
import { services } from '../../data/services';
import { primaryCta } from '../../data/cta';
import EnquiryButton from '../ui/EnquiryButton.astro';
---
<section id="services" class="services">
  <div class="container">
    <header class="services-header">
      <p class="font-eyebrow" data-fade>Services / 003</p>
      <h2 class="services-heading font-display" data-fade>
        How I can <span class="services-heading-italic">help</span> your business
      </h2>
    </header>

    <div class="services-grid">
      {services.map((s) => (
        <article class="service-card" data-service-card>
          <span class="service-index font-mono">{s.index} / {String(services.length).padStart(2, '0')}</span>
          <h3 class="service-title font-display">{s.title}</h3>
          <p class="service-body">{s.body}</p>
          <p class="service-price font-mono">{s.price}</p>
          <div class="service-enquiry"><EnquiryButton intent={s.enquiry} /></div>
        </article>
      ))}
    </div>

    <div class="services-support" data-fade>
      <p><strong>Support after launch.</strong> Optional hosting, maintenance and updates to keep things running smoothly.</p>
      <span class="font-mono">From ₹2,000/month</span>
    </div>

    <p class="services-note" data-fade>
      Not sure where to start?
      <a href={primaryCta.href}>Message me on WhatsApp</a>
      about what you want to build or improve, and we’ll work out the next step.
    </p>
  </div>
</section>

<style>
  .services {
    padding: var(--section-pad-t) 0 96px;
    position: relative;
  }
  @media (max-width: 720px) {
    .services-header { margin-bottom: 40px; }
  }
  .services-header {
    margin-bottom: 64px;
    max-width: 720px;
  }
  .services-heading {
    font-family: var(--font-display);
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1;
    letter-spacing: -0.025em;
    margin: 16px 0 0;
    color: var(--ink);
  }
  .services-heading-italic {
    font-style: italic;
    color: var(--accent);
    margin-right: 0.12em;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  @media (max-width: 900px) {
    .services-grid { grid-template-columns: 1fr; }
  }
  .service-card {
    display: flex;
    flex-direction: column;
    padding: 32px 28px;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: oklch(16.75% 0.011 262 / 0.5);
    transition: border-color 320ms ease, background 320ms ease, transform 320ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .service-card:hover {
      border-color: var(--accent);
      background: oklch(20% 0.014 262 / 0.7);
      transform: translateY(-2px);
    }
  }
  .service-index {
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
    margin-bottom: 20px;
  }
  .service-title {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1.1;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    color: var(--ink);
  }
  .service-body {
    margin: 0 0 28px;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
  }
  .service-price {
    margin: auto 0 0;
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--accent);
  }
  .service-enquiry { margin-top: 20px; }
  .services-support {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin-top: 28px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
  }
  .services-support p { margin: 0; max-width: 640px; }
  .services-support strong { color: var(--ink); font-weight: 500; }
  .services-support > span { font-size: 11px; }
  .services-note {
    margin: 28px 0 0;
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    max-width: 560px;
  }
  .services-note a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 240ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .services-note a:hover {
      color: var(--accent-hi);
    }
  }
</style>
