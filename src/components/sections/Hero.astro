---
import HeroWireframe from '../../islands/HeroWireframe.tsx';
import CtaButton from '../ui/CtaButton.astro';
import { primaryCta } from '../../data/cta';
import MotionControls from '../chrome/MotionControls.astro';
import BrandMark from '../ui/BrandMark.astro';
---
<section id="hero" class="hero">
  <HeroWireframe client:only="react" />
  <div class="hero-scanlines" aria-hidden="true"></div>
  <div class="hero-fallback" aria-hidden="true">
    <BrandMark class="hero-fallback-mark" />
  </div>
  <div class="container hero-content">
    <h1 class="hero-name font-display" data-hero-name>
      <span class="sr-only">Rohan Katara</span>
      <span class="hero-name-visual" aria-hidden="true" data-hero-name-visual>Rohan Katara</span>
    </h1>
    <p class="hero-role" data-hero-fade>
      I build websites and AI workflows, and improve existing processes
      so businesses can win more customers and spend less time on repetitive work.
    </p>
    <p class="hero-sub" data-hero-fade>
      Freelance developer based in Ahmedabad, working with businesses across Gujarat,
      India, and remotely worldwide.
      <span class="hero-sub-services font-mono">
        Website development · AI workflow creation · Workflow optimisation
      </span>
    </p>
    <div class="hero-ctas" data-hero-fade>
      <CtaButton href={primaryCta.href} label={primaryCta.label} variant="primary" />
      <CtaButton href="#services" label="How I can help" variant="ghost" />
    </div>
    <div class="hero-status font-mono" data-hero-status>
      <span class="status-dot" aria-hidden="true"></span>
      <span>Available for new projects</span>
    </div>
    <MotionControls variant="prompt" />
  </div>
  <div class="hero-scroll-hint font-mono" aria-hidden="true">
    <span>scroll</span>
    <span class="hero-scroll-line"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    overflow: hidden;
    isolation: isolate;
  }
  .hero-fallback {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse 60% 50% at 35% 45%,
        oklch(70% 0.18 262 / 0.20) 0%,
        transparent 60%
      ),
      radial-gradient(
        ellipse 80% 60% at 70% 70%,
        oklch(61.53% 0.1675 262 / 0.12) 0%,
        transparent 70%
      );
  }
  .hero[data-webgl="on"] .hero-fallback {
    display: none;
  }
  .hero-fallback :global(.hero-fallback-mark) {
    position: absolute;
    width: min(60vw, 640px);
    left: 68%;
    top: 50%;
    transform: translate(-50%, -50%);
    color: var(--accent-hi);
    opacity: 0.08;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    padding-top: 120px;
  }
  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 120px);
    line-height: 0.95;
    letter-spacing: -0.025em;
    margin: 0 0 24px;
    color: var(--ink);
    opacity: 0;
  }
  .hero-name-visual {
    display: inline-block;
  }
  .hero-name-visual :global(.char) {
    display: inline-block;
    will-change: transform, color;
  }
  .hero-role {
    font-size: clamp(18px, 2vw, 24px);
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
    margin: 0 0 20px;
    max-width: 780px;
    opacity: 0;
    transform: translateY(20px);
  }
  .hero-sub {
    font-size: 15px;
    line-height: 1.6;
    color: var(--muted);
    margin: 0 0 40px;
    max-width: 640px;
    opacity: 0;
    transform: translateY(20px);
  }
  .hero-sub-services {
    display: block;
    margin-top: 10px;
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--faint);
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0 0 40px;
    opacity: 0;
    transform: translateY(20px);
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
    padding: 12px 18px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: oklch(16.75% 0.011 262 / 0.6);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(20px);
  }
  .hero-status .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--success);
    animation: hero-pulse 2.4s ease-out infinite;
  }
  @keyframes hero-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.9); }
  }
  .hero-scroll-hint {
    position: absolute;
    bottom: 48px;
    left: 50%;
    transform: translateX(-50%);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--faint);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    z-index: 2;
  }
  .hero-scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, var(--faint), transparent);
    animation: scroll-line 2s ease-in-out infinite;
  }
  @keyframes scroll-line {
    0%, 100% { transform: scaleY(1); transform-origin: top; }
    50% { transform: scaleY(0.4); transform-origin: top; }
  }

  @media (max-width: 900px) {
    .hero-fallback :global(.hero-fallback-mark) { left: 50%; width: 82vw; }
  }
  @media (max-width: 720px) {
    .hero-content {
      padding-top: 88px;
      /* keep the last line of content clear of the absolute scroll hint */
      padding-bottom: 110px;
    }
    .hero-name { font-size: clamp(44px, 13.5vw, 56px); }
    .hero-role { font-size: 17px; }
    .hero-status { padding: 10px 14px; }
    .hero-scroll-hint { bottom: 20px; }
  }

  /* CRT scanline overlay — sits between the grid canvas (z=0) and content (z=2) */
  .hero-scanlines {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 2px,
      var(--scanline) 2px,
      var(--scanline) 3px
    );
    mix-blend-mode: multiply;
  }
</style>

