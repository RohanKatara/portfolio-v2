---
import { websites } from '../../data/websites';
---
<section class="website-work" id="website-work" aria-labelledby="website-work-title">
  <div class="container">
    <div class="website-work-heading">
      <div><p class="font-eyebrow">Selected website work / 03 projects</p><h2 id="website-work-title" class="font-display">Different brands.<br /><em>Distinct experiences.</em></h2></div>
      <a class="view-all" href="/websites/">Explore the websites <span aria-hidden="true">↗</span></a>
    </div>
    <div class="website-work-grid">
      {websites.map((project) => (
        <a class="website-teaser" href={`/websites/#${project.slug}`}>
          <div class="teaser-image"><img src={project.cover.src} srcset={project.cover.srcset} sizes="(min-width: 760px) 320px, calc(100vw - 48px)" width={project.cover.width} height={project.cover.height} alt={project.cover.alt} loading="lazy" decoding="async" /><span class="teaser-arrow" aria-hidden="true">↗</span></div>
          <div class="teaser-meta"><span class="font-mono">{project.index} / {project.category}</span><h3 class="font-display">{project.name}</h3><span class="teaser-status">Client project · Awaiting launch</span></div>
        </a>
      ))}
    </div>
    <p class="website-work-note">Designed and developed by me. Explore the work, then let’s talk about yours.</p>
  </div>
</section>
<style>
  .website-work { padding: 72px 0 80px; border-block: 1px solid var(--line); scroll-margin-top: 90px; background: #0d111b99; }
  .website-work-heading { display: flex; justify-content: space-between; align-items: end; gap: 24px; margin-bottom: 32px; }
  .website-work-heading .font-eyebrow { font-size: 10px; margin: 0 0 18px; }
  h2 { font-size: clamp(40px,5vw,62px); line-height: 1.05; margin: 0; }
  h2 em { color: var(--accent-hi); }
  .view-all { display: inline-flex; gap: 22px; align-items: center; min-height: 44px; font-size: 12px; border-bottom: 1px solid var(--muted); flex-shrink: 0; }
  .view-all span { font-size: 22px; color: var(--accent-hi); }
  .website-work-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 20px; }
  .website-teaser { min-width: 0; display: block; }
  .teaser-image { position: relative; overflow: hidden; border: 1px solid var(--line); background: var(--surface); aspect-ratio: 1.55; border-radius: 4px; }
  .teaser-image img { width: 100%; height: 100%; object-fit: cover; object-position: top left; transition: transform 600ms var(--ease-out); }
  .teaser-arrow { position: absolute; right: 10px; bottom: 10px; width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: #10131ce8; border: 1px solid #ffffff28; }
  .teaser-meta { padding-top: 18px; }
  .teaser-meta .font-mono { font-size: 8px; color: var(--muted); text-transform: uppercase; letter-spacing: .07em; }
  h3 { margin: 8px 0; font-size: 30px; line-height: 1.1; }
  .teaser-status { font-size: 10px; color: var(--muted); }
  .website-work-note { font-size: 12px; color: var(--muted); margin: 30px 0 0; }
  a:focus-visible { outline: 2px solid var(--accent-hi); outline-offset: 6px; border-radius: 3px; }
  @media (hover:hover) and (pointer:fine) { .website-teaser:hover img { transform: scale(1.035); } .view-all:hover { color: var(--accent-hi); } }
  @media (max-width:760px) {
    .website-work { padding-block: 48px; }
    .website-work-heading { display: block; margin-bottom: 26px; }
    .view-all { margin-top: 20px; }
    .website-work-grid { grid-template-columns: 1fr; gap: 32px; }
    .teaser-image { aspect-ratio: 1.85; }
    .teaser-meta { padding-top: 12px; }
    .teaser-meta .font-mono { font-size: 9px; }
    h3 { font-size: 33px; }
    .website-work-note { line-height: 1.7; }
  }
  @media (prefers-reduced-motion:reduce) { .teaser-image img { transition: none; } }
</style>
