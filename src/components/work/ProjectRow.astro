---
import ProjectHoverImage from '../../islands/ProjectHoverImage.tsx';
import type { Project } from '../../data/projects';

interface Props {
  project: Project;
}
const { project } = Astro.props;
---
<a
  class="project-row"
  href={`/work/${project.slug}/`}
  data-project-row
  style={`--row-accent: ${project.accent};`}
>
  <span class="row-index font-mono" data-row-meta>{project.index} / 04</span>
  <div class="row-main">
    <h3 class="row-title font-display" data-row-title>{project.name}</h3>
    <p class="row-tagline" data-row-meta>{project.tagline}</p>
    {project.buyerNote && (
      <p class="row-buyer-note" data-row-meta>
        <span class="row-buyer-mark" aria-hidden="true">↳</span> {project.buyerNote}
      </p>
    )}
    <span class="row-underline" data-row-underline></span>
  </div>
  <div class="row-meta-side">
    <span class="row-year font-mono" data-row-meta>{project.year}</span>
    <span class="row-stack font-mono" data-row-meta>{project.stack.slice(0, 2).join(' · ')}</span>
    <span class="row-arrow" aria-hidden="true">→</span>
  </div>
  <ProjectHoverImage client:visible slug={project.slug} alt={`${project.name} preview`} />
</a>

<style>
  .project-row {
    position: relative;
    display: grid;
    grid-template-columns: 80px 1fr auto;
    align-items: center;
    gap: 32px;
    padding: 48px 0;
    border-top: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: color 320ms ease, padding 320ms ease;
  }
  .project-row:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .project-row:last-of-type {
    border-bottom: 1px solid var(--line);
  }
  @media (hover: hover) and (pointer: fine) {
    .project-row:hover {
      padding-left: 16px;
    }
    .project-row:hover .row-title {
      color: var(--row-accent, var(--accent));
    }
    .project-row:hover .row-arrow {
      transform: translateX(8px);
    }
  }
  .row-index {
    font-size: 12px;
    color: var(--faint);
    letter-spacing: 0.08em;
  }
  .row-main {
    position: relative;
    min-width: 0;
  }
  .row-title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5.6vw, 76px);
    line-height: 1;
    margin: 0 0 12px;
    color: var(--ink);
    transition: color 320ms ease;
    letter-spacing: -0.02em;
  }
  .row-title :global(.char) {
    display: inline-block;
    will-change: transform;
  }
  .row-tagline {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
    max-width: 480px;
  }
  .row-buyer-note {
    margin: 8px 0 0;
    font-size: 13px;
    line-height: 1.5;
    color: var(--faint);
    max-width: 480px;
  }
  .row-buyer-mark {
    color: var(--row-accent, var(--accent));
  }
  .row-underline {
    position: absolute;
    bottom: -16px;
    left: 0;
    right: 0;
    height: 1px;
    background: var(--row-accent, var(--accent));
    transform-origin: left center;
    transform: scaleX(0);
    transition: transform 600ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .project-row:hover .row-underline {
      transform: scaleX(1);
    }
  }
  .row-meta-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    text-align: right;
  }
  .row-year {
    font-size: 12px;
    color: var(--muted);
  }
  .row-stack {
    font-size: 11px;
    color: var(--faint);
  }
  .row-arrow {
    margin-top: 8px;
    font-size: 24px;
    color: var(--row-accent, var(--accent));
    transition: transform 320ms var(--ease-out);
  }
  @media (max-width: 720px) {
    .project-row {
      grid-template-columns: 1fr;
      gap: 12px;
      padding: 32px 0;
    }
    .row-title { font-size: clamp(34px, 10vw, 76px); }
    .row-meta-side {
      flex-direction: row;
      align-items: center;
      text-align: left;
      gap: 12px;
    }
    .row-arrow {
      margin-top: 0;
      margin-left: auto;
    }
  }
</style>
