---
import '../styles/global.css';
import DesktopGate from '../islands/DesktopGate.tsx';
import SmoothScroll from '../islands/SmoothScroll.tsx';
import SpaceStarfield from '../islands/SpaceStarfield.tsx';
import MotionBootstrap from '../components/chrome/MotionBootstrap.astro';
import { brandIconVersion } from '../data/brand.mjs';
import { social } from '../data/bio';
import MobileContact from '../components/chrome/MobileContact.astro';
import type { EnquiryIntent } from '../data/cta';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  socialImage?: string;
  atmosphere?: boolean;
  enquiryIntent?: EnquiryIntent;
  enquiryReference?: string;
}

const isHome = Astro.url.pathname === '/';
const identityUrl = 'https://rohankatara.com/';
const {
  title = 'Rohan Katara | Freelance Web, App & AI Automation Developer in Ahmedabad',
  description = 'Freelance developer in Ahmedabad building websites, apps, and AI/WhatsApp automations that get businesses more customers and save hours of manual work. Working across Gujarat, India, and remotely worldwide.',
  canonicalPath = Astro.url.pathname,
  socialImage = 'https://rohankatara.com/og-image.png?v=2',
  atmosphere = isHome,
} = Astro.props;

const canonical = new URL(canonicalPath, identityUrl).href;
const shareImage = new URL(socialImage, identityUrl).href;

// Build-time rollback flags (flipping either requires a redeploy):
// - PUBLIC_FORCE_LEGACY=1 sends every visitor to /legacy/ regardless of device.
// - PUBLIC_MOBILE_LEGACY=1 restores the old mobile→/legacy/ redirect. Default
//   (unset) serves the responsive v2 site to phones.
const forceLegacy = import.meta.env.PUBLIC_FORCE_LEGACY === '1';
const mobileLegacy = import.meta.env.PUBLIC_MOBILE_LEGACY === '1';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <MotionBootstrap />
    <!-- Mobile + force-legacy redirect. Must run before paint, before any other
         script, and must mirror coffee-portfolio's useBreakpoint rule byte-for-byte
         (width < 768 || (hasTouch && Math.min(screen.w, screen.h) < 768)) so a
         visitor classified mobile here is also classified mobile by coffee's React
         hook on the next page. location.replace() leaves no history entry, so the
         browser back button never bounces back here. ?desktop=1 is an escape hatch
         for QA on touch laptops. -->
    <script is:inline define:vars={{ forceLegacy, mobileLegacy }}>
      (function () {
        try {
          if (location.pathname.indexOf('/legacy') === 0) return;
          if (location.search.indexOf('desktop=1') !== -1) return;
          var w = window.innerWidth;
          var hasTouch = navigator.maxTouchPoints > 0;
          var smallSide = Math.min(screen.width, screen.height);
          var isMobile = w < 768 || (hasTouch && smallSide < 768);
          if (forceLegacy || (mobileLegacy && isMobile)) {
            location.replace('/legacy/' + location.search + location.hash);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${brandIconVersion}`} />
    <!-- Keep this high-resolution raster URL stable for search crawlers. -->
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={`/favicon.svg?v=${brandIconVersion}`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`/apple-touch-icon.png?v=${brandIconVersion}`} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Rohan Katara" />
    <meta name="theme-color" content="#1A1B1F" />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Rohan Katara Portfolio" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <meta name="twitter:creator" content="@Rohan2Katara" />
    <meta name="twitter:site" content="@Rohan2Katara" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      'name': 'Rohan Katara',
      'url': identityUrl,
      'jobTitle': 'Freelance Software Developer',
      'description': description,
      'email': `mailto:${social.email}`,
      'address': {
        '@type': 'PostalAddress',
        'addressLocality': 'Ahmedabad',
        'addressCountry': 'India',
      },
      'areaServed': ['Gujarat', 'India', 'Worldwide'],
      'sameAs': [
        'https://github.com/RohanKatara',
        'https://www.linkedin.com/in/rohan-katara-5895952b6',
        'https://x.com/Rohan2Katara',
      ],
      'knowsAbout': [
        'React', 'Next.js', 'TypeScript', 'Generative AI',
        'Large Language Models', 'Node.js', 'Web Development',
        'AI Automation', 'WhatsApp Automation', 'Ecommerce Websites',
        'App Development',
      ],
    })} />

    {isHome && (
      <Fragment>
        <!-- Preserve bookmarked case studies and the former Work section URL. -->
        <script is:inline>
          function redirectLegacyWork() {
            var slugs = ['mocktalk', 'krishna', 'automate-pro', 'content-engine'];
            var h = (location.hash || '').replace(/^#/, '');
            if (slugs.indexOf(h) !== -1) location.replace('/work/' + h + '/' + location.search);
            else if (h === 'work') location.replace('/work/' + location.search);
            else if (h === 'website-work') location.replace('/work/' + location.search + '#websites');
          }
          redirectLegacyWork();
          window.addEventListener('hashchange', redirectLegacyWork);
        </script>
      </Fragment>
    )}
  </head>
  <body>
    <DesktopGate client:only="react" />
    {isHome && <SmoothScroll client:only="react" />}
    {atmosphere && <SpaceStarfield client:only="react" />}

    <slot />
    <MobileContact intent={Astro.props.enquiryIntent} reference={Astro.props.enquiryReference} />
  </body>
</html>
