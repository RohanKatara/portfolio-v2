---
// Vercel redirects first in production. This fallback supports static previews.
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, follow" />
  <link rel="canonical" href="https://rohankatara.com/work/" />
  <title>Work has moved | Rohan Katara</title>
  <script is:inline>location.replace('/work/' + location.search + location.hash);</script>
</head>
<body>
  <main class="redirect-message container">
    <h1 class="font-display">All the work. One place.</h1>
    <p><a href="/work/">Explore websites &amp; AI automations →</a></p>
  </main>
</body>
</html>
<style>
  .redirect-message { padding-top: 120px; }
  h1 { font-size: clamp(40px,7vw,80px); }
  a { color: var(--accent-hi); text-decoration: underline; text-underline-offset: 6px; }
</style>
