---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/chrome/Nav.astro';
import Footer from '../components/chrome/Footer.astro';
import Hero from '../components/sections/Hero.astro';
import SelectedWork from '../components/sections/SelectedWork.astro';
import Manifesto from '../components/sections/Manifesto.astro';
import Services from '../components/sections/Services.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import About from '../components/sections/About.astro';
import Contact from '../components/sections/Contact.astro';

---
<BaseLayout>
  <Nav />
  <main data-page-content>
    <Hero />
    <SelectedWork />
    <Manifesto />
    <Services />
    <Testimonials />
    <About />
    <Contact />
    <Footer />
  </main>
</BaseLayout>

<script>
  import {
    initHeroReveal,
    initManifestoPin,
    initServicesReveal,
    initTestimonialsReveal,
    initSectionFades,
    initAboutReveal,
    initContactReveal,
    initSkillsMarquee,
  } from '../lib/reveal';
  import { initHeroScramble } from '../lib/scramble';
  import { isMotionReduced } from '../lib/motion';

  const boot = () => {
    // Reduced motion: global.css already shows every reveal target at its
    // final state, so skipping the timelines leaves nothing stuck hidden.
    if (isMotionReduced()) return;
    initHeroReveal();
    initHeroScramble();
    initManifestoPin();
    initServicesReveal();
    initTestimonialsReveal();
    initSectionFades();
    initAboutReveal();
    initContactReveal();
    initSkillsMarquee();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
</script>
