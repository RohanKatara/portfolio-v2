# Build-time rollback flags. Set these in Vercel (Project > Settings >
# Environment Variables, Production scope) and redeploy — PUBLIC_* vars are
# baked in at build time, so flipping one always requires a redeploy.

# Send EVERY visitor to /legacy/ (the coffee portfolio) regardless of device.
# PUBLIC_FORCE_LEGACY=1

# Restore the old mobile→/legacy/ redirect (width < 768px or small touch
# screens). Unset (the default) serves the responsive v2 site to phones.
# ?desktop=1 in the URL bypasses the redirect for QA either way.
# PUBLIC_MOBILE_LEGACY=1
